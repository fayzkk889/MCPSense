{
  "name": "mcpsense",
  "version": "0.5.0",
  "description": "Local security inspection for MCP projects, available as a CLI and MCP server.",
  "bin": {
    "mcpsense": "bin/run.js"
  },
  "scripts": {
    "postinstall": "node bin/manage.cjs postinstall",
    "prepublishOnly": "node bin/wasm.js --verify"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "scanner",
    "cli",
    "eslint",
    "snyk",
    "ai",
    "llm",
    "prompt-injection"
  ],
  "author": "Faizan (https://github.com/fayzkk889)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fayzkk889/MCPSense"
  },
  "homepage": "https://mcpsense.site",
  "bugs": {
    "url": "https://github.com/fayzkk889/MCPSense/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "files": [
    "bin/run.js",
    "bin/manage.cjs",
    "bin/wasm.js",
    "runtime/",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ]
